# copy to .env and fill in; .env is git-ignored and docker-ignored
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<user>
MLFLOW_TRACKING_PASSWORD=<token>

# database (docker compose)
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=<choose-a-password>
POSTGRES_DB=visionguard

# web app
SECRET_KEY=<random-string>
THRESHOLD=0.771
MAX_UPLOAD_MB=5
# local = model inside the web container, remote = call the cloud model API
INFERENCE_MODE=local
MODEL_API_URL=https://<service>.run.app
MODEL_API_KEY=<long-random-key>
